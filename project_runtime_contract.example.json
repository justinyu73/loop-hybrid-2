{
  "_note": "Example project runtime contract. Copy to project_runtime_contract.json and adjust per project. Each stage that opts in with `delivery.derive = acceptance_lamp` gets a sealed delivery binding from its own acceptance lamp; the lamp's verifier must live outside `allowed_paths`. `executors` declares every model command the engine may run: an absolute argv[0] and a `{prompt}` slot (optionally `{model}` and `{base_url}`). `models.execute` names the declared coding executor; add `judge`/`judge_model` to route judging to another declared executor. `pricing` is optional; without it, costs stay unknown.",
  "schema": "lh-project-runtime-contract/v1",
  "project_id": "example-project",
  "campaign": {
    "schema": "lh-campaign/v1",
    "campaign_id": "example-campaign",
    "stages": [
      {
        "stage_id": "feature",
        "goal": {
          "must_have": [
            "the change described for this stage, with its tests"
          ],
          "must_not": [
            "push",
            "publish",
            "merge"
          ]
        },
        "allowed_paths": [
          "src/",
          "tests/"
        ],
        "allowed_side_effects": [
          "workspace",
          "artifact"
        ],
        "acceptance_lamp": {
          "id": "acceptance",
          "smoke": "sh checks/acceptance.sh",
          "verification_argv": [
            "sh",
            "checks/acceptance.sh"
          ]
        },
        "delivery": {
          "derive": "acceptance_lamp",
          "checks": [
            {
              "id": "diff-hygiene",
              "argv": [
                "git",
                "diff",
                "--cached",
                "--check"
              ]
            }
          ]
        },
        "max_attempts": 4,
        "next_stage_id": null
      }
    ]
  },
  "source_repo": ".",
  "base_revision": "main",
  "runtime": {
    "goal_store": "runtime/goals",
    "run_store": "runtime/runs",
    "workspace_root": "runtime/workspaces",
    "status_snapshot_out": "runtime/platform_status.json",
    "pause_flag": "runtime/loop-pause"
  },
  "executors": {
    "coder": {
      "argv": [
        "/absolute/path/to/your-coding-agent",
        "{prompt}"
      ],
      "usage": "none"
    }
  },
  "models": {
    "execute": "coder"
  }
}
